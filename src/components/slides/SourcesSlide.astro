---
import type { SourceEntry } from '../../types/presentation';

interface Props {
  slideIndex: number;
  heading: string;
  sources: SourceEntry[];
}
const { slideIndex, heading, sources } = Astro.props;

const sourceStyles = {
  book: {
    label: 'LIBRO',
    border: '5px solid var(--color-primary)',
  },
  electronic: {
    label: 'DOCUMENTO ELECTRÓNICO',
    border: '5px solid var(--color-accent)',
  },
};
---
<section class="slide bg-slide-light" id={`slide-${slideIndex}`} data-slide={slideIndex} style="display:flex;align-items:center;justify-content:center;">
  <div style="max-width:700px;padding:3rem 2rem 6rem;width:100%;" class="stagger-1">
    <h2 style="font-family:var(--font-display);font-size:2.5rem;font-weight:900;color:var(--color-primary);margin-bottom:2rem;text-align:center;" set:html={heading} />

    <div style="display:flex;flex-direction:column;gap:1rem;">
      {sources.map((src) => {
        const style = sourceStyles[src.type];
        return (
          <div style={`background:white;border-radius:var(--radius-md);padding:1.25rem 1.5rem;border-left:${style.border};box-shadow:var(--shadow-card);`}>
            <div style="font-size:0.7rem;font-weight:700;color:var(--color-muted);letter-spacing:0.1em;margin-bottom:0.4rem;">{style.label}</div>
            <p style="font-size:0.88rem;line-height:1.6;">
              <span set:html={src.text} />
              {src.url && (
                <a href={src.url} target="_blank" rel="noopener" style="color:var(--color-primary);font-weight:600;word-break:break-all;">{src.url}</a>
              )}
            </p>
          </div>
        );
      })}
    </div>

    <div style="text-align:center;margin-top:2rem;">
      <button onclick="window.goToSlide(0)" style="background:var(--color-primary);color:white;border:none;border-radius:var(--radius-full);padding:0.75rem 2rem;font-size:0.9rem;font-weight:700;cursor:pointer;transition:all 0.2s;" onmouseover="this.style.background='var(--color-primary-dark)'" onmouseout="this.style.background='var(--color-primary)'">
        ↩ Volver al inicio
      </button>
    </div>
  </div>
</section>
