---
import Badge from '../ui/Badge.astro';
import InfoBox from '../ui/InfoBox.astro';
import type { TextBlock } from '../../types/presentation';

interface Props {
  slideIndex: number;
  badge: string;
  heading: string;
  blocks: TextBlock[];
  image: string;
  imageAlt: string;
}
const { slideIndex, badge, heading, blocks, image, imageAlt } = Astro.props;
---
<section class="slide" id={`slide-${slideIndex}`} data-slide={slideIndex} style="display:flex;background:white;">
  <!-- Left image -->
  <div style="flex:0 0 42%;position:relative;overflow:hidden;">
    <img src={image} alt={imageAlt} style="width:100%;height:100%;object-fit:cover;" />
    <div style="position:absolute;inset:0;background:linear-gradient(to right, transparent 70%, white 100%);"></div>
  </div>

  <!-- Right content -->
  <div style="flex:1;display:flex;flex-direction:column;justify-content:center;padding:3rem 3rem 5rem;overflow-y:auto;">
    <div class="stagger-1">
      <Badge text={badge} />
    </div>
    <h2 style="font-family:var(--font-display);font-size:clamp(1.6rem,2.5vw,2.5rem);font-weight:800;color:var(--color-primary);margin-bottom:1.5rem;line-height:1.2;" class="stagger-2" set:html={heading} />

    <div style="display:flex;flex-direction:column;gap:1.25rem;max-width:560px;" class="stagger-3">
      {blocks.map((block) => (
        <InfoBox variant={block.variant}>
          <p style="font-size:0.95rem;line-height:1.7;color:var(--color-foreground);" set:html={block.content} />
        </InfoBox>
      ))}
    </div>
  </div>
</section>
