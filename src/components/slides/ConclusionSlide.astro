---
import Badge from '../ui/Badge.astro';
import type { ConclusionTag } from '../../types/presentation';

interface Props {
  slideIndex: number;
  badge: string;
  heading: string;
  paragraphs: string[];
  tags: ConclusionTag[];
  image: string;
}
const { slideIndex, badge, heading, paragraphs, tags, image } = Astro.props;

const tagStyles = {
  'primary-bg': 'background:oklch(95% 0.02 264); color:var(--color-primary);',
  'accent-bg': 'background:oklch(98% 0.02 85); color:var(--color-primary);',
  'primary-solid': 'background:var(--color-primary); color:white;',
};
---
<section class="slide" id={`slide-${slideIndex}`} data-slide={slideIndex} style="display:flex;background:white;">
  <!-- Left image -->
  <div style="flex:0 0 45%;position:relative;overflow:hidden;background:oklch(14% 0.02 264);">
    <img src={image} alt="Médicos de la antigüedad" style="width:100%;height:100%;object-fit:cover;opacity:0.6;" />
    <div style="position:absolute;inset:0;background:linear-gradient(135deg,var(--color-primary) 0%,transparent 60%);opacity:0.7;"></div>
    <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;">
      <div style="text-align:center;color:white;padding:2rem;">
        <div style="font-size:5rem;margin-bottom:1rem;animation:var(--animate-float);">🏛️</div>
        <p style="font-size:1.1rem;font-weight:600;opacity:0.9;">Historia de la Medicina</p>
      </div>
    </div>
  </div>

  <!-- Right: conclusion -->
  <div style="flex:1;display:flex;flex-direction:column;justify-content:center;padding:3rem 3rem 6rem;overflow-y:auto;">
    <div class="stagger-1">
      <Badge text={badge} />
    </div>
    <h2 style="font-family:var(--font-display);font-size:clamp(2rem,3.5vw,3rem);font-weight:900;color:var(--color-primary);margin-bottom:1.5rem;line-height:1.1;animation:var(--animate-slide-up);" class="stagger-2" set:html={heading} />
    
    <div style="max-width:500px;" class="stagger-3">
      {paragraphs.map((p, i) => (
        <p style={`font-size:0.95rem;line-height:1.8;color:var(--color-foreground);${i < paragraphs.length - 1 ? 'margin-bottom:1.25rem;' : ''}`} set:html={p} />
      ))}

      <div style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap;">
        {tags.map((tag) => {
          const style = tagStyles[tag.variant];
          return (
            <div style={`${style} border-radius:var(--radius-md);padding:0.75rem 1.25rem;font-size:0.82rem;font-weight:600;`} set:html={tag.text} />
          );
        })}
      </div>
    </div>
  </div>
</section>
