---
import Badge from '../ui/Badge.astro';
import Card from '../ui/Card.astro';
import Modal from '../ui/Modal.astro';
import type { ElementCard } from '../../types/presentation';

interface Props {
  slideIndex: number;
  badge?: string;
  heading?: string;
  intro: string;
  elements: ElementCard[];
  footnote: string;
}
const {
  slideIndex,
  badge,
  heading = 'Elementos que reconstruyen un modelo médico',
  intro,
  elements,
  footnote,
} = Astro.props;
---
<section class="slide bg-slide-light" id={`slide-${slideIndex}`} data-slide={slideIndex}>
  <div class="cards-modal-slide__accent cards-modal-slide__accent--top"></div>
  <div class="cards-modal-slide__accent cards-modal-slide__accent--bottom"></div>
  <div class="cards-modal-slide__shape cards-modal-slide__shape--left"></div>
  <div class="cards-modal-slide__shape cards-modal-slide__shape--right"></div>

  <div class="cards-modal-slide__inner">
    <div class="cards-modal-slide__stage">
      <header class="cards-modal-slide__header stagger-1">
        {badge && <Badge text={badge} />}
        <h2 class="cards-modal-slide__title" set:html={heading} />
        <p class="cards-modal-slide__intro" set:html={intro} />
      </header>

      <div class="cards-modal-slide__grid stagger-2">
        {elements.map((el, i) => {
          const modalId = `modal-el-${slideIndex}-${i}`;
          return (
            <Card
              num={el.num}
              title={el.title}
              color={el.color}
              modalId={modalId}
            />
          );
        })}
      </div>

      <p class="cards-modal-slide__footnote" set:html={footnote} />
    </div>
  </div>

  <!-- Modals for each element -->
  {elements.map((el, i) => {
    const modalId = `modal-el-${slideIndex}-${i}`;
    return (
      <Modal id={modalId} borderColor={el.color}>
        <div style="font-family:var(--font-display);font-size:2.5rem;font-weight:900;color:var(--color-primary);margin-bottom:0.5rem;">{el.num}</div>
        <h3 id={`${modalId}-title`} style="font-family:var(--font-display);font-size:1.4rem;font-weight:800;color:var(--color-primary);margin-bottom:0.5rem;">{el.question}</h3>
        <p style="font-size:0.85rem;color:var(--color-muted);margin-bottom:1.25rem;">({el.title})</p>
        <ul style="display:flex;flex-direction:column;gap:0.75rem;list-style:none;">
          {el.items.map((item) => (
            <li style="display:flex;align-items:center;gap:0.75rem;">
              <span style="width:0.5rem;height:0.5rem;border-radius:50%;background:var(--color-accent);flex-shrink:0;display:inline-block;"></span>
              <span style="font-size:0.95rem;" set:html={item}></span>
            </li>
          ))}
        </ul>
      </Modal>
    );
  })}

  <style>
    .cards-modal-slide__accent {
      position: absolute;
      left: 0;
      right: 0;
      height: 14px;
      background: var(--color-accent);
      z-index: 1;
    }

    .cards-modal-slide__accent--top { top: 0; }
    .cards-modal-slide__accent--bottom { bottom: 0; }

    .cards-modal-slide__shape {
      position: absolute;
      pointer-events: none;
      border-radius: 999px;
      opacity: 0.65;
      z-index: 0;
    }

    .cards-modal-slide__shape--left {
      width: 15rem;
      height: 15rem;
      left: -5rem;
      bottom: 4.5rem;
      border: 10px solid var(--color-accent);
    }

    .cards-modal-slide__shape--right {
      width: 23rem;
      height: 23rem;
      right: -8rem;
      top: 5rem;
      background: oklch(89% 0.06 264 / 0.42);
    }

    .cards-modal-slide__inner {
      position: relative;
      z-index: 2;
      height: 100%;
      display: grid;
      place-items: center;
      padding: clamp(1.25rem, 3vw, 2.5rem) clamp(1.25rem, 4vw, 4rem) 6rem;
      overflow: hidden;
    }

    .cards-modal-slide__stage {
      width: min(100%, 1110px);
      min-height: min(66vh, 560px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: clamp(1.75rem, 3vw, 3rem);
      border: 3px solid oklch(92% 0.02 264);
      border-top: 9px solid var(--color-accent);
      border-radius: 1.35rem;
      background:
        linear-gradient(135deg, oklch(100% 0 0 / 0.96), oklch(96% 0.01 264 / 0.96)),
        white;
      box-shadow: 0 24px 70px oklch(20% 0.03 264 / 0.14);
    }

    .cards-modal-slide__header {
      text-align: center;
      margin: 0 auto clamp(1.4rem, 2.5vw, 2.4rem);
      max-width: 820px;
    }

    .cards-modal-slide__title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3.45rem);
      font-weight: 900;
      line-height: 0.98;
      color: var(--color-primary);
      margin: 0;
      text-wrap: balance;
    }

    .cards-modal-slide__intro {
      max-width: 790px;
      font-size: clamp(0.88rem, 1.15vw, 1rem);
      color: var(--color-foreground);
      line-height: 1.58;
      margin: 1rem auto 0;
      text-wrap: pretty;
    }

    .cards-modal-slide__grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: clamp(1rem, 2vw, 1.5rem);
      align-items: stretch;
      width: 100%;
      max-width: 960px;
      margin: 0 auto;
    }

    .cards-modal-slide__footnote {
      max-width: 800px;
      text-align: center;
      font-size: clamp(0.78rem, 1vw, 0.88rem);
      line-height: 1.55;
      color: var(--color-muted);
      margin: 1.35rem auto 0;
    }

    @media (max-width: 920px) {
      .cards-modal-slide__stage {
        min-height: auto;
        padding: 1.5rem;
      }

      .cards-modal-slide__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        max-width: 620px;
      }
    }

    @media (max-width: 560px) {
      .cards-modal-slide__inner {
        align-items: start;
        padding: 3.2rem 1rem 5.5rem;
      }

      .cards-modal-slide__stage {
        border-radius: 1rem;
        border-width: 2px;
        border-top-width: 7px;
        padding: 1.15rem;
      }

      .cards-modal-slide__header {
        margin-bottom: 1rem;
      }

      .cards-modal-slide__title {
        font-size: clamp(1.45rem, 8vw, 2rem);
      }

      .cards-modal-slide__intro {
        font-size: 0.8rem;
        line-height: 1.45;
        margin-top: 0.65rem;
      }

      .cards-modal-slide__grid {
        gap: 0.75rem;
      }

      .cards-modal-slide__footnote {
        font-size: 0.72rem;
        margin-top: 0.8rem;
      }
    }
  </style>
</section>
