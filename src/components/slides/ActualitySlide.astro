---
import Badge from '../ui/Badge.astro';
import GlassCard from '../ui/GlassCard.astro';
import type { ActualityBox } from '../../types/presentation';

interface Props {
  slideIndex: number;
  badge: string;
  heading: string;
  intro: string;
  bgImage: string;
  boxes: ActualityBox[];
}
const { slideIndex, badge, heading, intro, bgImage, boxes } = Astro.props;
---
<section class="slide" id={`slide-${slideIndex}`} data-slide={slideIndex} style="position:relative;overflow:hidden;">
  <!-- Background image with overlay -->
  <img src={bgImage} alt={heading} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;" />
  <div style="position:absolute;inset:0;background:oklch(10% 0.02 264 / 0.72);z-index:1;"></div>

  <div style="position:relative;z-index:2;height:100%;display:flex;flex-direction:column;padding:2rem 3rem 6rem;justify-content:space-between;color:white;">
    <div style="text-align:center;" class="stagger-1">
      <Badge text={badge} />
      <h2 style="font-family:var(--font-display);font-size:clamp(1.8rem,3vw,2.8rem);font-weight:900;animation:var(--animate-float);display:inline-block;" set:html={heading} />
      <p style="max-width:680px;margin:0.75rem auto 0;font-size:0.9rem;line-height:1.6;opacity:0.9;" set:html={intro} />
    </div>

    <!-- 3 glassmorphism boxes -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;">
      {boxes.map((box) => (
        <GlassCard
          image={box.image}
          icon={box.icon}
          title={box.title}
          text={box.text}
          delay={box.delay}
        />
      ))}
    </div>
  </div>
</section>
