---
interface Props {
  slideIndex: number;
  title: string;
  author: string;
  image: string;
  imageAlt: string;
}
const { slideIndex, title, author, image, imageAlt } = Astro.props;
---
<section class="slide bg-slide-white" id={`slide-${slideIndex}`} data-slide={slideIndex} style="display:flex;">
  <!-- Yellow decorative strip top -->
  <div style="position:absolute;top:0;left:0;right:0;height:10px;background:var(--color-accent);z-index:2;"></div>
  <!-- Yellow decorative strip bottom -->
  <div style="position:absolute;bottom:0;left:0;right:0;height:10px;background:var(--color-accent);z-index:2;"></div>

  <!-- Left: image panel -->
  <div style="flex:0 0 48%;height:100%;position:relative;overflow:hidden;">
    <img src={image} alt={imageAlt} style="width:100%;height:100%;object-fit:cover;object-position:center;" />
    <!-- Corner arch decoration -->
    <div style="position:absolute;bottom:-4rem;left:-4rem;width:14rem;height:14rem;border:8px solid var(--color-accent);border-radius:50%;opacity:0.6;"></div>
  </div>

  <!-- Right: content panel -->
  <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:3rem;background:var(--color-surface);position:relative;overflow:hidden;">
    <!-- Big decorative circle -->
    <div class="deco-circle" style="width:18rem;height:18rem;background:var(--color-accent);top:-5rem;right:-5rem;opacity:0.9;z-index:0;"></div>
    <div class="deco-ring" style="width:12rem;height:12rem;border-color:var(--color-accent);top:2rem;right:2rem;z-index:1;opacity:0.5;"></div>

    <div style="position:relative;z-index:2;text-align:center;max-width:420px;" class="stagger-1">
      <h1 style="font-family:var(--font-display);font-size:clamp(2.5rem,5vw,4rem);font-weight:900;color:var(--color-primary);line-height:1.1;margin-bottom:2rem;" set:html={title} />
      <p style="font-size:1rem;color:var(--color-muted);font-weight:500;letter-spacing:0.05em;">
        {author}
      </p>
    </div>
  </div>
</section>
