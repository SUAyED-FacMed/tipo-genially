---
interface Props {
  image?: string;
  icon?: string;
  title: string;
  text: string;
  delay: string;
}
const { image, icon, title, text, delay } = Astro.props;
---
<div style={`
  background:oklch(100% 0 0 / 0.12);
  backdrop-filter:blur(12px);
  border:1px solid oklch(100% 0 0 / 0.2);
  border-radius:var(--radius-lg);
  overflow:hidden;
  display:flex;flex-direction:column;
  animation:var(--animate-slide-up);
  animation-delay:${delay};
  animation-fill-mode:both;
  transition:transform 0.25s;
`}
  class="postit-card"
>
  {image ? (
    <img src={image} alt={title} style="width:100%;height:9rem;object-fit:cover;flex-shrink:0;" />
  ) : (
    <div style="width:100%;height:9rem;background:oklch(100% 0 0 / 0.1);display:flex;align-items:center;justify-content:center;font-size:4rem;flex-shrink:0;">{icon}</div>
  )}
  <div style="padding:1.25rem;flex:1;display:flex;flex-direction:column;gap:0.5rem;color:white;">
    <h3 style="font-family:var(--font-display);font-size:0.95rem;font-weight:800;color:var(--color-accent);line-height:1.3;">{title}</h3>
    <p style="font-size:0.8rem;line-height:1.6;opacity:0.9;">{text}</p>
  </div>
</div>
