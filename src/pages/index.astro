---
import PresentationLayout from '../layouts/PresentationLayout.astro';
import { u2 } from '../data/u2';

// Import slide components
import CoverSlide from '../components/slides/CoverSlide.astro';
import IndexSlide from '../components/slides/IndexSlide.astro';
import TextImageSlide from '../components/slides/TextImageSlide.astro';
import CardsModalSlide from '../components/slides/CardsModalSlide.astro';
import ModelsSlide from '../components/slides/ModelsSlide.astro';
import TimelineSlide from '../components/slides/TimelineSlide.astro';
import TimelineContinuationSlide from '../components/slides/TimelineContinuationSlide.astro';
import SyncSlide from '../components/slides/SyncSlide.astro';
import ActualitySlide from '../components/slides/ActualitySlide.astro';
import ConclusionSlide from '../components/slides/ConclusionSlide.astro';
import SourcesSlide from '../components/slides/SourcesSlide.astro';
---

<PresentationLayout title={u2.title} description={u2.description} totalSlides={u2.totalSlides}>
  <!-- SLIDE 0 — PORTADA -->
  <CoverSlide slideIndex={0} {...u2.cover} />

  <!-- SLIDE 1 — ÍNDICE -->
  <IndexSlide slideIndex={1} items={u2.indexItems} />

  <!-- SLIDE 2 — ¿QUÉ ES UN MODELO MÉDICO? -->
  <TextImageSlide slideIndex={2} {...u2.definition} />

  <!-- SLIDE 3 — ELEMENTOS DEL MODELO -->
  <CardsModalSlide slideIndex={3} {...u2.elements} />

  <!-- SLIDE 4 — MODELOS MÉDICOS MÁS ESTUDIADOS -->
  <ModelsSlide slideIndex={4} {...u2.models} />

  <!-- SLIDE 5 — LÍNEA DE TIEMPO DIACRÓNICA -->
  <TimelineSlide slideIndex={5} {...u2.timeline} />

  <!-- SLIDE 6 — CONTINUIDAD DE LA LÍNEA DE TIEMPO -->
  <TimelineContinuationSlide slideIndex={6} {...u2.timelineContinuation} />

  <!-- SLIDE 7 — PERSPECTIVA SINCRÓNICA (texto + ejemplo) -->
  <SyncSlide slideIndex={7} {...u2.sync} />

  <!-- SLIDE 8 — DIACRONÍA-SINCRONÍA EN LA ACTUALIDAD -->
  <ActualitySlide slideIndex={8} {...u2.actuality} />

  <!-- SLIDE 9 — CONCLUSIÓN -->
  <ConclusionSlide slideIndex={9} {...u2.conclusion} />

  <!-- SLIDE 10 — FUENTES -->
  <SourcesSlide slideIndex={10} {...u2.sources} />
</PresentationLayout>
