<script>
  // Timeline accordion
  function toggleTimeline(i: number) {
    const item = document.getElementById(`tl-item-${i}`);
    const sub  = document.getElementById(`tl-sub-${i}`);
    if (!item || !sub) return;
    const isOpen = item.classList.contains('open');
    // Close all
    document.querySelectorAll('.timeline-item').forEach((el, idx) => {
      el.classList.remove('open');
      el.setAttribute('aria-expanded', 'false');
      const s = document.getElementById(`tl-sub-${idx}`);
      if (s) s.style.cssText = '';
    });
    if (!isOpen) {
      item.classList.add('open');
      item.setAttribute('aria-expanded', 'true');
    }
  }

  // Expose globally (Astro island boundary)
  (window as any).toggleTimeline = toggleTimeline;

  // Keyboard on timeline
  document.querySelectorAll('.timeline-item').forEach((el, i) => {
    el.addEventListener('keydown', (e: Event) => {
      const ke = e as KeyboardEvent;
      if (ke.key === 'Enter' || ke.key === ' ') {
        ke.preventDefault();
        toggleTimeline(i);
      }
    });
  });
</script>
