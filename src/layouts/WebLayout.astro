---
// WebLayout — lienzo fijo 16:9 (1600×900) escalado a la ventana, con avance horizontal.
// Navegación real: índice desplegable, barra de progreso clicable por pantalla,
// una URL (#id) por pantalla, teclado y deslizamiento táctil.
import '../styles/web.css';

export interface SlideRef { id: string; section: number; label: string }
interface Props {
  title: string;
  description?: string;
  slides: SlideRef[];
  sections: { id: string; label: string }[];
}
const { title, description = '', slides, sections } = Astro.props;

// Pantallas agrupadas por sección para la línea de tiempo (la portada es el grupo -1)
const groups = Map.groupBy(slides.map((s, i) => ({ ...s, i })), (s) => s.section);
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="viewport" id="viewport">
    <div class="stage" id="stage">
      <div class="track" id="track" style={`--n:${slides.length}`}>
        <slot />
      </div>
    </div>
  </div>

  <nav class="bar" aria-label="Navegación">
    <button class="bar__index" id="menu-btn" type="button" aria-expanded="false" aria-controls="toc">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" /></svg>
      Índice
    </button>
    <button class="bar__arrow" id="prev" type="button" aria-label="Pantalla anterior">←</button>
    <ol class="bar__groups">
      {[...groups].map(([section, items]) => (
        <li class="bar__group" data-group={section} style={`flex-grow:${items.length}`}>
          {section >= 0 && <span class="bar__gnum" aria-hidden="true">{section + 1}</span>}
          <ol class="bar__segs">
            {items.map((s) => (
              <li><a href={`#${s.id}`} data-seg={s.i} title={s.label} aria-label={s.label}></a></li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
    <button class="bar__arrow" id="next" type="button" aria-label="Pantalla siguiente">→</button>
    <p class="bar__where" aria-live="polite"><span class="bar__pos" id="pos"></span><span class="bar__label" id="where"></span></p>
  </nav>

  <div class="drawer" id="toc" hidden>
    <div class="drawer__panel" role="dialog" aria-label="Índice">
      <p class="drawer__title">{title}</p>
      <ol>
        <li><a href={`#${slides[0].id}`} data-toc="-1"><span class="drawer__num">·</span>Portada</a></li>
        {sections.map((s, i) => (
          <li><a href={`#${s.id}`} data-toc={i}><span class="drawer__num">{i + 1}</span>{s.label}</a></li>
        ))}
      </ol>
    </div>
  </div>

  <!-- Aviso para celulares en vertical (solo CSS lo muestra; se puede descartar) -->
  <div class="rotate" role="dialog" aria-modal="true" aria-labelledby="rotate-t">
    <svg class="rotate__icon" viewBox="0 0 64 64" aria-hidden="true">
      <rect x="20" y="6" width="24" height="44" rx="4" />
      <circle cx="32" cy="44" r="1.6" />
    </svg>
    <p class="rotate__title" id="rotate-t">Gira tu dispositivo</p>
    <p class="rotate__text">Esta presentación se ve mejor en horizontal.</p>
    <button class="rotate__skip" id="rotate-skip" type="button">Seguir en vertical</button>
  </div>

  <script>
    // Aviso de girar: si se descarta, no vuelve durante esta visita
    const dismissRotate = () => document.documentElement.classList.add('rotate-dismissed');
    try { if (sessionStorage.getItem('rotate-dismissed')) dismissRotate(); } catch {}
    document.getElementById('rotate-skip')!.addEventListener('click', () => {
      dismissRotate();
      try { sessionStorage.setItem('rotate-dismissed', '1'); } catch {}
    });

    const W = 1600, H = 900;
    const viewport = document.getElementById('viewport')!;
    const stage = document.getElementById('stage')!;
    const track = document.getElementById('track')!;
    const slides = [...track.querySelectorAll<HTMLElement>(':scope > .slide')];
    const segs = [...document.querySelectorAll<HTMLAnchorElement>('[data-seg]')];
    const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
    const where = document.getElementById('where')!;
    const pos = document.getElementById('pos')!;
    const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
    const prev = document.getElementById('prev') as HTMLButtonElement;
    const next = document.getElementById('next') as HTMLButtonElement;
    const menuBtn = document.getElementById('menu-btn')!;
    const toc = document.getElementById('toc')!;
    let current = -1;

    // Escala el lienzo para que siempre quepa completo
    const fit = () => {
      const r = viewport.getBoundingClientRect();
      stage.style.setProperty('--s', String(Math.min(r.width / W, r.height / H)));
    };
    new ResizeObserver(fit).observe(viewport);

    // Retraso escalonado para las animaciones de entrada
    slides.forEach((s) => s.querySelectorAll<HTMLElement>('.reveal').forEach((el, k) => el.style.setProperty('--d', `${k * 90}ms`)));

    // Ráfaga de confeti: una sola vez por visita, sale de las cifras de la pantalla.
    // Se dibuja en un canvas de 1600×900 dentro de la pantalla, así escala con el lienzo.
    const celebrate = (slide: HTMLElement) => {
      const key = `celebrated:${slide.id}`;
      try { if (sessionStorage.getItem(key)) return; sessionStorage.setItem(key, '1'); } catch {}
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      setTimeout(() => { // espera a que termine el deslizamiento entre pantallas
        const canvas = document.createElement('canvas');
        canvas.width = W; canvas.height = H;
        canvas.className = 'confetti';
        canvas.setAttribute('aria-hidden', 'true');
        slide.append(canvas);
        const ctx = canvas.getContext('2d')!;
        const css = getComputedStyle(document.documentElement);
        const colors = ['--amber', '--teal', '--navy'].map((v) => css.getPropertyValue(v).trim());

        // Origen: cada cifra grande; si la pantalla no tiene, el centro
        const sr = slide.getBoundingClientRect();
        const s = sr.width / W;
        const origins = [...slide.querySelectorAll('.stat__value')].map((el) => {
          const range = document.createRange(); // el texto, no el bloque (que ocupa toda la columna)
          range.selectNodeContents(el);
          const r = range.getBoundingClientRect();
          return { x: (r.left - sr.left + r.width / 2) / s, y: (r.top - sr.top + r.height / 2) / s };
        });
        if (!origins.length) origins.push({ x: W / 2, y: H / 2 });

        const parts = origins.flatMap((o) => Array.from({ length: 45 }, () => {
          const a = -Math.PI / 2 + (Math.random() - 0.5) * 1.6; // abanico hacia arriba
          const v = 9 + Math.random() * 9;
          return {
            x: o.x, y: o.y, vx: Math.cos(a) * v, vy: Math.sin(a) * v,
            w: 6 + Math.random() * 6, h: 10 + Math.random() * 8,
            r: Math.random() * Math.PI, vr: (Math.random() - 0.5) * 0.4,
            c: colors[Math.floor(Math.random() * colors.length)],
          };
        }));

        const DURATION = 1400;
        const t0 = performance.now();
        let last = t0;
        const frame = (t: number) => {
          const p = (t - t0) / DURATION;
          const dt = Math.min(3, (t - last) / 16.7); // en "cuadros de 60 fps", para que no dependa del monitor
          last = t;
          ctx.clearRect(0, 0, W, H);
          ctx.globalAlpha = Math.max(0, 1 - Math.max(0, p - 0.6) / 0.4); // se desvanece al final
          for (const q of parts) {
            q.vy += 0.45 * dt; q.vx *= 0.985 ** dt; q.x += q.vx * dt; q.y += q.vy * dt; q.r += q.vr * dt;
            ctx.save(); ctx.translate(q.x, q.y); ctx.rotate(q.r);
            ctx.fillStyle = q.c; ctx.fillRect(-q.w / 2, -q.h / 2, q.w, q.h * Math.cos(q.r * 2));
            ctx.restore();
          }
          if (p < 1) requestAnimationFrame(frame); else canvas.remove();
        };
        requestAnimationFrame(frame);
      }, SLIDE_MS + 350);
    };

    const indexOf = (hash: string) => Math.max(0, slides.findIndex((s) => `#${s.id}` === hash));

    // Las animaciones de entrada (.is-shown) arrancan cuando la pantalla ya casi llegó, no durante el
    // deslizamiento. La pantalla que sale conserva su estado hasta quedar fuera de vista, para que no "caiga".
    const SLIDE_MS = 600; // igual que la transición de .track en web.css
    let showTimer = 0, hideTimer = 0;

    const go = (i: number, updateUrl = true) => {
      i = Math.max(0, Math.min(slides.length - 1, i));
      if (i === current) return;
      current = i;
      clearTimeout(showTimer);
      clearTimeout(hideTimer);
      const instant = track.classList.contains('no-anim');
      // La que entra anima cuando ya casi llegó; las demás se reinician cuando ya salieron de cuadro
      showTimer = window.setTimeout(() => slides[i].classList.add('is-shown'), instant ? 60 : SLIDE_MS * 0.8);
      hideTimer = window.setTimeout(
        () => slides.forEach((s, k) => k !== i && s.classList.remove('is-shown')),
        instant ? 0 : SLIDE_MS + 50,
      );
      track.style.setProperty('--i', String(i));
      slides.forEach((s, k) => {
        s.classList.toggle('is-active', k === i);
        s.toggleAttribute('inert', k !== i);
      });
      segs.forEach((a, k) => {
        a.toggleAttribute('aria-current', k === i);
        a.classList.toggle('is-done', k < i);
      });
      const sec = Number(slides[i].dataset.section);
      tocLinks.forEach((a) => a.toggleAttribute('aria-current', Number(a.dataset.toc) === sec));
      groups.forEach((g) => {
        const n = Number(g.dataset.group);
        g.classList.toggle('is-current', n === sec);
        g.classList.toggle('is-done', n < sec);
      });
      pos.textContent = slides[i].dataset.pos ?? '';
      where.textContent = slides[i].dataset.label ?? '';
      prev.disabled = i === 0;
      next.disabled = i === slides.length - 1;
      if (updateUrl && location.hash !== `#${slides[i].id}`) history.replaceState(null, '', `#${slides[i].id}`);
      if (slides[i].hasAttribute('data-celebrate')) celebrate(slides[i]);
    };

    // Primera carga sin transición
    track.classList.add('no-anim');
    go(indexOf(location.hash), false);
    requestAnimationFrame(() => requestAnimationFrame(() => track.classList.remove('no-anim')));

    addEventListener('hashchange', () => go(indexOf(location.hash), false));
    prev.addEventListener('click', () => go(current - 1));
    next.addEventListener('click', () => go(current + 1));

    // Índice desplegable
    const setMenu = (open: boolean) => {
      menuBtn.setAttribute('aria-expanded', String(open));
      toc.hidden = !open;
      if (open) toc.querySelector<HTMLElement>('a[aria-current]')?.focus();
    };
    menuBtn.addEventListener('click', () => setMenu(toc.hidden));
    toc.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a') || e.target === toc) setMenu(false);
    });

    addEventListener('keydown', (e) => {
      if (e.key === 'Escape') return setMenu(false);
      if (!toc.hidden) return;
      if (['ArrowRight', 'PageDown', ' '].includes(e.key)) { e.preventDefault(); go(current + 1); }
      if (['ArrowLeft', 'PageUp'].includes(e.key)) { e.preventDefault(); go(current - 1); }
      if (e.key === 'Home') go(0);
      if (e.key === 'End') go(slides.length - 1);
    });

    // Deslizar en pantallas táctiles
    let x0 = 0, y0 = 0;
    viewport.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
    viewport.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) go(current + (dx < 0 ? 1 : -1));
    });

    // Solo en desarrollo: marca en rojo las pantallas cuyo contenido no cabe
    if (import.meta.env.DEV) {
      addEventListener('load', () => {
        document.documentElement.classList.add('measuring'); // quita transformaciones que inflan scrollHeight
        slides.forEach((s) => {
          const body = s.querySelector<HTMLElement>('.slide__body');
          if (body && body.scrollHeight > body.clientHeight + 1) {
            s.classList.add('is-overflow');
            console.warn(`[16:9] La pantalla #${s.id} no cabe: sobran ${body.scrollHeight - body.clientHeight}px. Pásala a una segunda pantalla.`);
          }
        });
        document.documentElement.classList.remove('measuring');
      });
    }
  </script>
</body>
</html>
